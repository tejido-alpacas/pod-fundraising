# Copy this file to .env at the repository root and replace every `replace-me`.
# .env is ignored by git. Never commit real values.
#
# All ten names are required. The app parses them once at startup and refuses to start,
# naming each problem, if one is missing, empty, malformed or still `replace-me`.
# There are no fallbacks.

# --- Tejido's own data -------------------------------------------------------

# The database (D1) and uploaded evidence (R2) need no value here. Locally they are kept
# in ./data, which `npm run dev` creates.

# Encrypts session cookies. At least 32 characters. Generate: openssl rand -hex 32
SESSION_SECRET=replace-me

# Qatom sends this in the X-Tejido-Checkin-Secret header on every POST /api/checkins.
# Enter the same value as a sensitive header dispatch parameter on both catalog items.
# 32 or more printable characters, no spaces. Generate: openssl rand -hex 32
CHECKIN_SHARED_SECRET=replace-me

# --- Qatom, shared ------------------------------------------------------------

# Origin of the Qatom payment API, with no path.
# Staging: https://pay.stage.m.todaq.net   Production: https://pay.m.todaq.net
PAYMENT_API_URL=replace-me

# Tejido's managed MCP server on Qatom. The agent chat connects to it as the signed-in person.
QATOM_MCP_URL=replace-me

# --- Qatom identity 1: a person, signed in with Qatom ---------------------------
# The sign-in client registration. This is NOT the merchant account below.

OIDC_CLIENT_ID=replace-me

# The sign-in client's own secret, issued with the client ID above. Not the merchant
# account's secret.
OIDC_CLIENT_SECRET=replace-me

# Must match the registration exactly. It points at the App. Local development: http://localhost:5174/auth/callback
OIDC_REDIRECT_URI=replace-me

# --- Qatom identity 2: Tejido's merchant account --------------------------------
# Owns every campaign's catalog items, reads their ledgers and pays refunds.
# Server-side only. These are NOT the sign-in client above.

QATOM_ACCOUNT_CLIENT_ID=replace-me
QATOM_ACCOUNT_CLIENT_SECRET=replace-me

# --- Anthropic ------------------------------------------------------------------

# Runs the model behind the agent chat.
ANTHROPIC_API_KEY=replace-me
