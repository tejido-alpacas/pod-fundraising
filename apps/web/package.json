{
	"name": "@tejido/web",
	"version": "0.0.0",
	"private": true,
	"description": "The one web app: user-facing pages and server routes.",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "svelte-kit sync && eslint --max-warnings=0 .",
		"test": "svelte-kit sync && vitest run"
	},
	"dependencies": {
		"@libsql/client": "^0.18.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tejido/config": "*",
		"@tejido/contracts": "*",
		"@tejido/db": "*",
		"@tejido/qatom": "*",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"vite": "^8.3.8"
	}
}
