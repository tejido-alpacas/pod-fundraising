{
	"name": "@tejido/web",
	"version": "0.0.0",
	"private": true,
	"description": "The one web app: user-facing pages and server routes.",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "wrangler dev --port 5173 --inspector-port 9229 --persist-to ../../data/wrangler --env-file ../../.env",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "svelte-kit sync && eslint --max-warnings=0 .",
		"test": "svelte-kit sync && vitest run"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261114.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tejido/config": "*",
		"@tejido/contracts": "*",
		"@tejido/db": "*",
		"@tejido/qatom": "*",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"vite": "^8.3.8",
		"wrangler": "^4.162.0"
	}
}
