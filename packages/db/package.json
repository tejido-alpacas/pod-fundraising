{
	"name": "@tejido/db",
	"version": "0.0.0",
	"private": true,
	"description": "Tejido's own database: schema, client, migrations and seed.",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./admin": "./src/admin.ts",
		"./testing": "./src/testing.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint --max-warnings=0 .",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node src/cli.ts migrate",
		"db:seed": "node src/cli.ts seed",
		"db:seed:sql": "node src/cli.ts seed-sql",
		"db:seed:e2e:sql": "node src/cli.ts e2e-seed-sql",
		"db:prepare": "node src/cli.ts prepare",
		"db:reset": "node src/cli.ts reset"
	},
	"dependencies": {
		"@tejido/config": "*",
		"@tejido/contracts": "*",
		"drizzle-orm": "^0.45.4"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261114.1",
		"drizzle-kit": "^0.31.11",
		"wrangler": "^4.162.0"
	}
}
