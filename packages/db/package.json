{
	"name": "@tejido/db",
	"version": "0.0.0",
	"private": true,
	"description": "Tejido's own database: schema, client, migrations and seed.",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./admin": "./src/admin.ts",
		"./testing": "./src/testing.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint --max-warnings=0 .",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node src/cli.ts migrate",
		"db:seed": "node src/cli.ts seed",
		"db:prepare": "node src/cli.ts prepare",
		"db:reset": "node src/cli.ts reset"
	},
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"@tejido/config": "*",
		"@tejido/contracts": "*",
		"drizzle-orm": "^0.45.4"
	},
	"devDependencies": {
		"drizzle-kit": "^0.31.11"
	}
}
