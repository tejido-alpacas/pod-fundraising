# Dependencies
node_modules

# Build output
.svelte-kit
build
dist

# Environment: real values stay on your machine
.env
.env.*
!.env.example

# Local data: the D1 database and R2 evidence that Wrangler keeps for the dev servers
/data
.wrangler
wrangler.deploy.jsonc

# npm is the only package manager here. These must never be committed.
pnpm-lock.yaml
yarn.lock
bun.lock
bun.lockb
.pnp.*
.yarn

# Worktrees agents make for their branches
.worktrees
.claude/worktrees

# The end-to-end suite: its screenshots and report, and each test person's signed-in browser
# state (a session cookie: never commit it, never upload it)
/e2e/artifacts
/e2e/.auth
/e2e/.test-output

# Tooling
*.tsbuildinfo
.eslintcache
coverage
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# OS and editors
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json
